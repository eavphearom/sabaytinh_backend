# PAYWAY_SANDBOX_ENABLED=false
# PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# PAYWAY_MERCHANT_ID=
# PAYWAY_API_KEY=
# PAYWAY_CALLBACK_URL=
# PAYWAY_CALLBACK_SECRET=
# PAYWAY_CONNECT_TIMEOUT=5
# PAYWAY_READ_TIMEOUT=15
# PAYWAY_QR_LIFETIME_MINUTES=15
# PAYWAY_LEASE_SECONDS=90
# PAYWAY_PUBLIC_API_ENABLED=false
# PAYWAY_CALLBACK_APPROVED=false
# PAYWAY_SANDBOX_VERIFIED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# PAYMENT_WORKER_INTERVAL_SECONDS=15
# PAYMENT_WORKER_BATCH_SIZE=20
# PAYWAY_WORKER_VERIFIED=false
# # Optional internal live probes; never enabled by application code.
# PAYWAY_RUN_SANDBOX_TESTS=false
# PAYWAY_RUN_QR_ONLY_TESTS=false

# Callback-independent Sandbox: PAYWAY_CALLBACK_URL and PAYWAY_CALLBACK_SECRET may remain empty.
# Public checkout still requires PUBLIC_API_ENABLED, SANDBOX_VERIFIED and WORKER_VERIFIED.
# CALLBACK_APPROVED applies only to callback delivery and must remain false until authenticated callbacks are verified.
# Worker startup can make gateway requests; run only after explicit Sandbox testing authorization.

# cron-job.org HTTP worker (new; no changes to payment readiness flags)
# CRON_SECRET=  # Generate a random token with at least 32 characters; never commit it.
# PAYMENT_CRON_BATCH_SIZE=1
# PAYMENT_CRON_BUDGET_SECONDS=20
# PAYMENT_CRON_CONNECT_TIMEOUT=1
# PAYMENT_CRON_READ_TIMEOUT=2

# Google login: Web application OAuth client; secret stays on the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact WEBSITE callback URL registered in Google Cloud (no trailing slash).
# Local example: http://localhost:5173/auth/google/callback
GOOGLE_REDIRECT_URI=
